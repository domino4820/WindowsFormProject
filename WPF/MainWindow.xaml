<Window x:Class="LauncherGames.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Launcher" Height="350" Width="525">
    <Grid>
        <Label Content="Game Name:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"/>
        <TextBox Name="txtGameName" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="80,10,0,0" Width="200"/>
        <Button Name="btnInstall" Content="Install" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,50,0,0" Width="75" Click="btnInstall_Click"/>
        <Button Name="btnPlay" Content="Play" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="100,50,0,0" Width="75" Click="btnPlay_Click"/>
        <Button Name="btnDelete" Content="Delete" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="190,50,0,0" Width="75" Click="btnDelete_Click"/>
        <ProgressBar Name="progressBar" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,100,0,0" Width="300" Height="20"/>
        <TextBlock Name="txtStatus" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,130,0,0" Width="300" Text=""/>
    </Grid>
</Window>